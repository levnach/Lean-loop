# Configuration for the Lean certificate improvement loop (sourced by loop.sh).
FORK="levnach/z3"
UPSTREAM="Z3Prover/z3"
BASE_BRANCH="master"
PAGES_BRANCH="gh-pages"
PAGES_URL="https://levnach.github.io/z3"
BRANCH_PREFIX="loop/iter"

# Workflows whose checks must pass before a loop PR is merged (anchored regex
# over the workflow name as reported by `gh pr checks`).
GATING_WORKFLOWS='^(CI|Windows|OCaml Binding CI \(Ubuntu \+ macOS\)|WebAssembly Build|Solver determinism)$'
CI_TIMEOUT_MIN=240       # give up waiting for CI after this long
CI_POLL_SEC=120          # polling interval
CI_SETTLE_MIN=8          # minimum wait so that all workflows register their checks
# A pull request whose changed files all match this regex is merged on the loop's local gate
# (Python example tests, z3test proof script tests, Lean-certified matrices, run on this machine)
# instead of waiting for GitHub CI. Anything else, in particular src/, keeps the full CI gate.
LOCAL_GATE_PATHS='^(examples/python/|lean/|doc/|[^/]*\.md$|\.gitignore$)'
LOCAL_GATE_TIMEOUT_MIN=30  # per local gate step
MAX_CI_FIX_ATTEMPTS=2    # CI-fixer rounds per PR

AGENT_TIMEOUT_MIN=180    # wall-clock limit per agent run
AGENT_MAX_TURNS=400

# Tools the sub-agents may use. No `git push`, no `gh pr create/merge`, no arbitrary
# command runners: the driver alone talks to GitHub. loop.sh appends build-dir-specific
# entries (the z3 and test-z3 binaries by absolute path).
AGENT_ALLOWED_TOOLS="Read,Edit,MultiEdit,Write,Glob,Grep,TodoWrite,\
Bash(git status:*),Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git add:*),Bash(git commit:*),\
Bash(git checkout:*),Bash(git switch:*),Bash(git restore:*),Bash(git reset:*),Bash(git rebase:*),\
Bash(git rm:*),Bash(git mv:*),Bash(git stash:*),Bash(git rev-parse:*),Bash(git rev-list:*),Bash(git blame:*),\
Bash(git grep:*),Bash(git ls-files:*),Bash(git branch:*),Bash(git merge-base:*),Bash(git apply:*),\
Bash(python3:*),Bash(python:*),Bash(cmake:*),Bash(ninja:*),\
Bash(./scripts/check_lean.sh:*),Bash(scripts/check_lean.sh:*),Bash(bash scripts/check_lean.sh:*),\
Bash(./build/z3:*),Bash(build/z3:*),Bash(./build/test-z3:*),Bash(build/test-z3:*),Bash(lake:*),Bash(lean:*),Bash(elan:*),\
Bash(gh run view:*),Bash(gh run list:*),Bash(gh pr view:*),Bash(gh pr checks:*),Bash(gh pr diff:*),Bash(gh pr list:*),\
Bash(ls:*),Bash(cat:*),Bash(head:*),Bash(tail:*),Bash(sed:*),Bash(awk:*),Bash(grep:*),Bash(rg:*),Bash(find:*),\
Bash(wc:*),Bash(diff:*),Bash(sort:*),Bash(uniq:*),Bash(cut:*),Bash(tr:*),Bash(jq:*),Bash(mkdir:*),Bash(cp:*),\
Bash(mv:*),Bash(touch:*),Bash(echo:*),Bash(printf:*),Bash(pwd),Bash(which:*),Bash(tee:*),Bash(true),Bash(test:*),\
Bash(cd:*),Bash(export:*),Bash(date:*),Bash(curl:*)"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
CLAUDE_MODEL="${CLAUDE_MODEL:-}"   # empty = account default
BUILD_JOBS=12
